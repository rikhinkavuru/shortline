# Shortline runs in dry-run mode by default and places no calls.
# To place real CALL-E calls you must set ALL THREE of the following.
SHORTLINE_MODE=dry-run
# CALLE_API_KEY=iams_live_...
# SHORTLINE_LIVE_ACK=I_UNDERSTAND_REAL_CALLS_COST_MONEY_AND_CANNOT_BE_RECALLED

# Optional
# CALLE_BASE_URL=https://api.heycall-e.com
# SHORTLINE_DB=./data/shortline.sqlite
# SHORTLINE_PORT=8787
# SHORTLINE_PUBLIC_URL=https://your-host.example   # enables terminal webhooks; polling is used otherwise
# SHORTLINE_AUTH_TOKEN=change-me                   # required when SHORTLINE_MODE=live and the server is exposed
