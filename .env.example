# Shortline runs in dry-run mode by default and places no calls.
# To place real CALL-E calls you must set ALL FOUR of the following.
SHORTLINE_MODE=dry-run
# CALLE_API_KEY=iams_live_...
# SHORTLINE_LIVE_ACK=I_UNDERSTAND_REAL_CALLS_COST_MONEY_AND_CANNOT_BE_RECALLED
# SHORTLINE_CALLER_NAME=Shortline          # the name the assistant discloses on every call; required in live mode

# Optional
# CALLE_BASE_URL=https://api.heycall-e.com
# SHORTLINE_DB=./data/shortline.sqlite
# SHORTLINE_HOST=127.0.0.1                 # bind address for `serve`
# SHORTLINE_PORT=8787
# SHORTLINE_PUBLIC_URL=https://your-host.example   # enables terminal webhooks at /webhooks/calle; polling is used otherwise
# SHORTLINE_AUTH_TOKEN=change-me           # required whenever SHORTLINE_MODE=live serves the dashboard
# SHORTLINE_BATCH_SIZE=6                   # max recipients per CALL-E call task (1-20)
# SHORTLINE_KEEP_TRANSCRIPTS_DAYS=14       # masked transcripts kept for evidence; 0 disables storage
# SHORTLINE_POLL_INTERVAL_MS=5000          # recovery poller cadence while serving
# SHORTLINE_FAKE_PACE_MS=0                 # dry-run only: >0 makes fake calls progress visibly instead of instantly
